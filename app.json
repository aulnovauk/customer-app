{
  "expo": {
    "name": "Beauté",
    "slug": "beaute",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/images/icon.png",
    "scheme": "beaute",
    "userInterfaceStyle": "automatic",
    "splash": {
      "backgroundColor": "#E85A8B",
      "resizeMode": "contain"
    },
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.beaute.app",
      "infoPlist": {
        "NSLocationWhenInUseUsageDescription": "We need your location to find salons near you.",
        "NSCameraUsageDescription": "We need camera access for your profile photo."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/images/icon.png",
        "backgroundColor": "#E85A8B"
      },
      "package": "com.beaute.app",
      "permissions": [
        "ACCESS_FINE_LOCATION",
        "ACCESS_COARSE_LOCATION",
        "CAMERA"
      ]
    },
    "web": {
      "bundler": "metro",
      "output": "static",
      "favicon": "./assets/images/icon.png"
    },
    "plugins": [
      "expo-router",
      "expo-font"
    ]
  }
}
